20%20%20%20%20%2A%5Cn%20%20%20%20%20%2A%20For%2064-byte%20signatures%2C%20%60v%60%20is%20automatically%20normalized%20to%2027%20or%2028.%5Cn%20%20%20%20%20%2A%20For%2065-byte%20signatures%2C%20%60v%60%20is%20returned%20as-is%20and%20MUST%20already%20be%2027%20or%2028%20for%20use%20with%20ecrecover.%5Cn%20%20%20%20%20%2A%5Cn%20%20%20%20%20%2A%20Consider%20validating%20the%20result%20before%20use%2C%20or%20use%20%7BtryRecover%7D%2F%7Brecover%7D%20which%20perform%20full%20validation.%5Cn%20%20%20%20%20%2A%2F%5Cn%20%20%20%20function%20parse%28bytes%20memory%20signature%29%20internal%20pure%20returns%20%28uint8%20v%2C%20bytes32%20r%2C%20bytes32%20s%29%20%7B%5Cn%20%20%20%20%20%20%20%20assembly%20%28%5C%22memory-safe%5C%22%29%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%2F%2F%20Check%20the%20signature%20length%5Cn%20%20%20%20%20%20%20%20%20%20%20%20switch%20mload%28signature%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%2F%2F%20-%20case%2065%3A%20r%2Cs%2Cv%20signature%20%28standard%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20case%2065%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20r%20%3A%3D%20mload%28add%28signature%2C%200x20%29%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20s%20%3A%3D%20mload%28add%28signature%2C%200x40%29%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20v%20%3A%3D%20byte%280%2C%20mload%28add%28signature%2C%200x60%29%29%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%2F%2F%20-%20case%2064%3A%20r%2Cvs%20signature%20%28cf%20https%3A%2F%2Feips.ethereum.org%2FEIPS%2Feip-2098%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20case%2064%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20let%20vs%20%3A%3D%20mload%28add%28signature%2C%200x40%29%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20r%20%3A%3D%20mload%28add%28signature%2C%200x20%29%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20s%20%3A%3D%20and%28vs%2C%20shr%281%2C%20not%280%29%29%29%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20v%20